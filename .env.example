# Yayın ortamı için. Geliştirmede hiçbirini vermen gerekmez.
DEBUG=0
SECRET_KEY=uzun-rastgele-bir-deger
ALLOWED_HOSTS=ornek.com
CSRF_TRUSTED_ORIGINS=https://ornek.com
SITE_URL=https://ornek.com
SITE_NAME=Berber Randevu

DB_NAME=berber
DB_USER=berber
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Birden fazla sunucu süreci varsa zorunlu (kod gönderim sınırları burada sayılır)
REDIS_URL=redis://127.0.0.1:6379/0

# Gerçek SMS sağlayıcı sınıfı. Boş bırakılırsa mesajlar yalnızca günlüğe yazılır.
SMS_BACKEND=core.sms.ConsoleBackend
SMS_UNIT_COST=0.17
SMS_OTP_UNIT_COST=0.24

# Cloudflare Turnstile (bot kontrolü). İkisi de doluysa kod gönderiminden önce doğrulanır.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
